generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Timeframe {
  DAILY
  WEEKLY
  MONTHLY
}

enum ExecutionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionProjectStatus {
  ON_TRACK
  NEEDS_ATTENTION
  BLOCKED
  COMPLETED
}

enum ExecutionActiveStatus {
  ACTIVE_NOW
  ACTIVE_LATER
  PARKED
  COMPLETED
}

enum ExecutionWeeklyFocus {
  TOP_3
  ACTIVE
  NONE
}

enum ExecutionTaskType {
  ACTION
  FOLLOW_UP
  ADMIN
  QUICK_WIN
}

enum ExecutionDurationBucket {
  UNDER_30_MIN
  THIRTY_TO_SIXTY_MIN
  ONE_TO_TWO_HOURS
  TWO_HOURS_PLUS
}

enum ExecutionTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  DONE
  DROPPED
}

enum ExecutionWhenBucket {
  TODAY
  THIS_WEEK
  LATER
  WAITING
  PARKING_LOT
}

enum ExecutionRecurrenceFrequency {
  NONE
  DAILY
  WORKDAYS
  WEEKENDS
  WEEKLY
  CUSTOM_WEEKDAYS
  MONTHLY
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AgentWorkState {
  QUEUED
  PLANNING
  RUNNING
  VERIFYING
  RETRY
  NEEDS_RYAN
  AWAITING_EXECUTION
  READY_FOR_REVIEW
  DONE
  FAILED
  PARKED
}

enum AgentActionState {
  PROPOSED
  AWAITING_OWNER_APPROVAL
  AUTHORIZED
  AWAITING_EXECUTION
  EXECUTING
  VERIFYING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum AgentDecisionStatus {
  PENDING
  RESOLVED
  CANCELLED
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                String                   @id @default(cuid())
  email             String                   @unique
  passwordHash      String
  name              String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  settings          UserSettings?
  watchlist         WatchlistTicker[]
  savedFilters      SavedSignalFilter[]
  executionDomains  ExecutionDomain[]
  executionProjects ExecutionProject[]
  executionTasks    ExecutionTask[]
  taskReferences     ExecutionTaskReference[]
  dailyPlans        DailyPlan[]
  queueItems        QueueItem[]
  pipelineActions   PipelineAction[]
  rykasDays         RykasDay[]
  parkedIdeas       ParkedIdea[]
  weeklyResets      WeeklyReset[]
  notebooks         Notebook[]
  notebookEntries   NotebookEntryIndex[]
  wisdomEntries     WisdomEntry[]
  wisdomReflections WisdomReflection[]
  seasons           Season[]
  agentConfigs      AgentProjectConfig[]
  machineWork       AgentWorkItem[]
  agentRuns         AgentRun[]
  ownerDecisions    AgentDecision[]
  agentEvents       AgentEvent[]
  agentActions      AgentActionRequest[]
  agentRunners      AgentRunner[]
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  accountSize            Float?
  maxRiskPerTradePercent Float    @default(2)
  preferredDteMin        Int      @default(30)
  preferredDteMax        Int      @default(60)
  definedRiskOnly        Boolean  @default(true)
  earningsBufferDays     Int      @default(7)
  concentrationLimit     Int      @default(4)
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchlistTicker {
  id                  String    @id @default(cuid())
  userId              String
  symbol              String
  sector              String?
  manualIvrBucket     String?
  nextEarningsDate    DateTime?
  lastManualRefreshAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

model PriceBar {
  id        String    @id @default(cuid())
  symbol    String
  timeframe Timeframe
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  adjClose  Float?
  provider  String
  fetchedAt DateTime  @default(now())

  @@unique([symbol, timeframe, date])
  @@index([symbol, timeframe, date])
}

model FetchState {
  id            String    @id @default(cuid())
  symbol        String
  provider      String
  lastFetchedAt DateTime
  rangeStart    DateTime?
  rangeEnd      DateTime?

  @@unique([symbol, provider])
}

model SavedSignalFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model ExecutionDomain {
  id              String               @id @default(cuid())
  userId          String
  name            String
  slug            String
  description     String?
  isDefault       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects        ExecutionProject[]
  tasks           ExecutionTask[]
  notebookEntries NotebookEntryIndex[]

  @@unique([userId, slug])
  @@index([userId, name])
}

model Season {
  id          String             @id @default(cuid())
  userId      String
  title       String
  description String?
  startedAt   DateTime?
  completedAt DateTime?
  status      SeasonStatus       @default(ACTIVE)
  themeColor  String?
  icon        String?
  isCurrent   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    ExecutionProject[]

  @@unique([userId, title])
  @@index([userId, isCurrent])
  @@index([userId, status, startedAt])
}

model ExecutionProject {
  id              String                 @id @default(cuid())
  userId          String
  domainId        String
  seasonId        String?
  name            String
  status          ExecutionProjectStatus @default(ON_TRACK)
  activeStatus    ExecutionActiveStatus  @default(ACTIVE_NOW)
  weeklyFocus     ExecutionWeeklyFocus   @default(NONE)
  priority        ExecutionPriority      @default(MEDIUM)
  nextAction      String?
  waitingOn       String?
  blocked         Boolean                @default(false)
  note            String?
  lastReviewedAt  DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          ExecutionDomain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  season          Season?                @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tasks           ExecutionTask[]
  notebookEntries NotebookEntryIndex[]
  agentConfig     AgentProjectConfig?
  agentWorkItems  AgentWorkItem[]
  agentRuns       AgentRun[]
  agentDecisions  AgentDecision[]
  agentEvents     AgentEvent[]
  agentActions    AgentActionRequest[]

  @@unique([userId, name])
  @@index([userId, activeStatus, weeklyFocus, priority])
  @@index([userId, seasonId])
}

model AgentProjectConfig {
  id                         String           @id @default(cuid())
  userId                     String
  projectId                  String           @unique
  profile                    String           @default("GENERIC_PM")
  operatingMode              String           @default("SIMULATION")
  enabled                    Boolean          @default(true)
  pausedAt                   DateTime?
  objective                  String
  primaryKpi                 String?
  currentBottleneck          String?
  projectManagerInstructions String
  autonomyPolicy             String
  escalationPolicy           String
  maxConcurrentWorkItems     Int              @default(2)
  workspaceIdentifier        String?
  lastAgentReviewAt          DateTime?
  nextAgentReviewAt          DateTime?
  health                     String           @default("UNKNOWN")
  spendingThresholdCents     Int?
  externalActionApproval     String?
  leaseToken                 String?
  leaseExpiresAt             DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  user                       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                    ExecutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, nextAgentReviewAt])
  @@index([leaseExpiresAt])
}

model AgentWorkItem {
  id                   String               @id @default(cuid())
  userId               String
  projectId            String
  parentWorkItemId     String?
  idempotencyKey       String
  title                String
  objective            String
  expectedValue        String
  acceptanceCriteria   String
  agentRole            String
  actionCategory       String               @default("RESEARCH_READ_ONLY")
  requiredCapability   String               @default("REPOSITORY_READ")
  sandboxPolicy        String               @default("READ_ONLY")
  networkPolicy        String               @default("OFF")
  operationalContext   String?
  priority             ExecutionPriority    @default(MEDIUM)
  state                AgentWorkState       @default(QUEUED)
  attemptCount         Int                  @default(0)
  maxAttempts          Int                  @default(3)
  blocker              String?
  resultSummary        String?
  evidenceSummary      String?
  executorIdentifier   String?
  providerIdentifier   String?
  externalThreadId     String?
  externalRunId        String?
  workspaceIdentifier  String?
  repositoryIdentifier String?
  claimToken           String?
  leaseExpiresAt       DateTime?
  heartbeatAt          DateTime?
  nextEligibleRunAt    DateTime?
  createdAt            DateTime             @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project              ExecutionProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentWorkItem       AgentWorkItem?       @relation("AgentWorkTree", fields: [parentWorkItemId], references: [id], onDelete: SetNull)
  childWorkItems       AgentWorkItem[]      @relation("AgentWorkTree")
  runs                 AgentRun[]
  decisions            AgentDecision[]
  events               AgentEvent[]
  actionRequests       AgentActionRequest[]

  @@unique([projectId, idempotencyKey])
  @@index([userId, state, nextEligibleRunAt])
  @@index([projectId, state, priority])
  @@index([parentWorkItemId])
  @@index([leaseExpiresAt])
}

model AgentRun {
  id                       String               @id @default(cuid())
  userId                   String
  workItemId               String
  projectId                String
  retryOfRunId             String?
  idempotencyKey           String               @unique
  role                     String
  runType                  String
  status                   AgentRunStatus       @default(RUNNING)
  providerIdentifier       String?
  modelIdentifier          String?
  executorIdentifier       String?
  externalThreadId         String?
  externalRunId            String?
  operationalResultSummary String?
  evidence                 String?
  error                    String?
  structuredOutcome        String?
  workspaceIdentifier      String?
  repositoryIdentifier     String?
  commitSha                String?
  pullRequestUrl           String?
  testOutcome              String?
  qaFeedback               String?
  startedAt                DateTime             @default(now())
  completedAt              DateTime?
  createdAt                DateTime             @default(now())
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem                 AgentWorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  project                  ExecutionProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retryOfRun               AgentRun?            @relation("AgentRunRetry", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retryRuns                AgentRun[]           @relation("AgentRunRetry")
  decisions                AgentDecision[]
  events                   AgentEvent[]
  actionRequests           AgentActionRequest[]

  @@index([userId, startedAt])
  @@index([workItemId, startedAt])
  @@index([projectId, status])
  @@index([retryOfRunId])
}

model AgentDecision {
  id                    String              @id @default(cuid())
  userId                String
  projectId             String
  originatingWorkItemId String?
  originatingRunId      String?
  idempotencyKey        String              @unique
  category              String
  question              String
  context               String
  recommendedChoice     String?
  availableChoices      String
  expectedUpside        String?
  risk                  String
  amountCents           Int?
  currency              String?
  status                AgentDecisionStatus @default(PENDING)
  selectedChoice        String?
  resultingAction       String?
  createdAt             DateTime            @default(now())
  resolvedAt            DateTime?
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               ExecutionProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originatingWorkItem   AgentWorkItem?      @relation(fields: [originatingWorkItemId], references: [id], onDelete: SetNull)
  originatingRun        AgentRun?           @relation(fields: [originatingRunId], references: [id], onDelete: SetNull)
  events                AgentEvent[]
  actionRequest         AgentActionRequest?

  @@index([userId, status, createdAt])
  @@index([projectId, status])
  @@index([originatingWorkItemId])
  @@index([originatingRunId])
}

model AgentEvent {
  id             String           @id @default(cuid())
  userId         String
  projectId      String
  workItemId     String?
  runId          String?
  decisionId     String?
  idempotencyKey String           @unique
  type           String
  summary        String
  metadata       String?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        ExecutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem       AgentWorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  run            AgentRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  decision       AgentDecision?   @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([workItemId, createdAt])
}

model AgentActionRequest {
  id                  String           @id @default(cuid())
  userId              String
  projectId           String
  workItemId          String
  originatingRunId    String?
  decisionId          String?          @unique
  idempotencyKey      String           @unique
  actionFingerprint   String           @unique
  category            String
  capability          String
  state               AgentActionState @default(PROPOSED)
  boundedPayload      String
  authorizationBounds String
  amountCents         Int?
  currency            String?
  expiresAt           DateTime?
  authorizedAt        DateTime?
  executionStartedAt  DateTime?
  executedAt          DateTime?
  verifiedAt          DateTime?
  cancelledAt         DateTime?
  executorIdentifier  String?
  externalExecutionId String?
  executionEvidence   String?
  failure             String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             ExecutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem            AgentWorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  originatingRun      AgentRun?        @relation(fields: [originatingRunId], references: [id], onDelete: SetNull)
  decision            AgentDecision?   @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([userId, state, createdAt])
  @@index([projectId, state])
  @@index([workItemId])
}

model AgentRunner {
  id                  String               @id @default(cuid())
  userId              String
  keyId               String               @unique
  name                String
  enabled             Boolean              @default(true)
  version             String?
  capabilities        String               @default("[]")
  status              String               @default("OFFLINE")
  currentWorkItemId   String?
  lastHeartbeatAt     DateTime?
  lastSuccessfulRunAt DateTime?
  recentFailure       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestNonces       RunnerRequestNonce[]

  @@index([userId, enabled])
  @@index([lastHeartbeatAt])
}

model RunnerRequestNonce {
  id        String      @id @default(cuid())
  runnerId  String
  requestId String      @unique
  timestamp DateTime
  bodyHash  String
  expiresAt DateTime
  createdAt DateTime    @default(now())
  runner    AgentRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, createdAt])
  @@index([expiresAt])
}

model ExecutionTask {
  id                  String                       @id @default(cuid())
  userId              String
  domainId            String
  projectId           String?
  title               String
  type                ExecutionTaskType            @default(ACTION)
  estimatedDuration   ExecutionDurationBucket?
  status              ExecutionTaskStatus          @default(NOT_STARTED)
  priority            ExecutionPriority            @default(MEDIUM)
  whenBucket          ExecutionWhenBucket          @default(LATER)
  dueDate             DateTime?
  followUpDate        DateTime?
  waitingOn           String?
  note                String?
  source              String?
  isBlocked           Boolean                      @default(false)
  pinToTodayUntilDone Boolean                      @default(false)
  recurrenceFrequency ExecutionRecurrenceFrequency @default(NONE)
  recurrenceWeekdays  String?
  recurrenceEndDate   DateTime?
  recurrenceParentId  String?
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  // RyanOS extensions. Allowed blockType values: cchcs, pipeline, rykas, admin, personal.
  blockType           String?
  isNeedle            Boolean                      @default(false)
  isBuild             Boolean                      @default(false)
  recipient           String?
  owedToLeadership    Boolean                      @default(false)
  shippedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  completedAt         DateTime?
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain              ExecutionDomain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  project             ExecutionProject?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  references          ExecutionTaskReference[]

  @@index([userId, whenBucket, status, priority, dueDate])
  @@index([userId, followUpDate])
  @@index([userId, recurrenceFrequency])
  @@index([recurrenceParentId])
  @@index([userId, scheduledStart])
  @@index([userId, blockType, scheduledStart])
  @@index([userId, isNeedle, scheduledStart])
  @@index([userId, shippedAt])
  @@index([projectId, status])
}

model ExecutionTaskReference {
  id        String        @id @default(cuid())
  userId    String
  taskId    String
  provider  String        @default("other")
  title     String
  url       String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      ExecutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
}

model DailyPlan {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  needleMove     String?
  ruleStep       Int?
  needleTaskId   String?
  rykasDismissed Boolean  @default(false)
  shutdownNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model QueueItem {
  id         String    @id @default(cuid())
  userId     String
  title      String
  lane       String
  recipient  String
  nextAction String
  status     String    @default("queued")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, resolvedAt])
}

model PipelineAction {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  type      String
  withWhom  String?
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, type])
  @@index([userId, createdAt])
}

model RykasDay {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  toShip       String?
  offersDone   Boolean  @default(false)
  listedCount  Int      @default(0)
  sourced      Boolean  @default(false)
  backlogAfter Int      @default(0)
  capOverride  Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model ParkedIdea {
  id               String   @id @default(cuid())
  userId           String
  idea             String
  lane             String
  triggerCondition String?
  status           String   @default("parked")
  renewals         Int      @default(0)
  parkedAt         DateTime @default(now())
  touchedAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, touchedAt])
  @@index([userId, parkedAt])
}

model WeeklyReset {
  id                         String    @id @default(cuid())
  userId                     String
  weekOf                     DateTime
  loopsShipped               Int       @default(0)
  loopsKilled                Int       @default(0)
  loopsParked                Int       @default(0)
  conversations              Int       @default(0)
  ships                      Int       @default(0)
  rykasBacklog               Int       @default(0)
  overridesCount             Int       @default(0)
  outcomes                   String
  promotedIdeaId             String?
  paperReflectionStartedAt   DateTime?
  paperReflectionCompletedAt DateTime?
  notebookProcessedAt        DateTime?
  weekTheme                  String?
  guideGeneratedAt           DateTime?
  completedAt                DateTime?
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
  @@index([userId, completedAt])
}

model Notebook {
  id          String               @id @default(cuid())
  userId      String
  title       String
  number      Int?
  startedAt   DateTime?
  completedAt DateTime?
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     NotebookEntryIndex[]

  @@unique([userId, number])
  @@index([userId, startedAt])
  @@index([userId, completedAt])
}

model NotebookEntryIndex {
  id            String            @id @default(cuid())
  userId        String
  notebookId    String
  date          DateTime?
  pageNumber    Int
  title         String
  summary       String?
  domainId      String?
  projectId     String?
  entryType     String
  photoUrl      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook      Notebook          @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  domain        ExecutionDomain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  project       ExecutionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  wisdomEntries WisdomEntry[]

  @@index([userId, date])
  @@index([userId, entryType])
  @@index([notebookId, pageNumber])
  @@index([domainId])
  @@index([projectId])
}

model WisdomEntry {
  id              String              @id @default(cuid())
  userId          String
  title           String
  idea            String
  takeaway        String?
  application     String?
  sourceType      String              @default("other")
  sourceName      String?
  author          String?
  reference       String?
  category        String              @default("Other")
  capturedAt      DateTime            @default(now())
  favorite        Boolean             @default(false)
  active          Boolean             @default(false)
  tags            String?
  photoUrl        String?
  status          String              @default("library")
  notebookEntryId String?
  lastShownAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookEntry   NotebookEntryIndex? @relation(fields: [notebookEntryId], references: [id], onDelete: SetNull)
  reflections     WisdomReflection[]

  @@index([userId, status, active, favorite])
  @@index([userId, category])
  @@index([userId, sourceType])
  @@index([userId, lastShownAt])
  @@index([notebookEntryId])
}

model WisdomReflection {
  id        String      @id @default(cuid())
  userId    String
  wisdomId  String
  date      DateTime    @default(now())
  text      String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wisdom    WisdomEntry @relation(fields: [wisdomId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([wisdomId, createdAt])
}

model DailyBriefDispatch {
  id        String    @id @default(cuid())
  dateKey   String    @unique
  emailTo   String
  status    String    @default("SENT")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}

model ContactLead {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String?
  businessType    String?
  revenueBand     String?
  amazonPresence  String?
  multipleSellers String?
  pricingIssues   String?
  supportNeed     String?
  catalogSize     String?
  primaryGoal     String?
  timeline        String?
  message         String?
  requestedAsset  String?
  source          String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
}
